<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title else site.name %}
{%- set pageDesc = description or site.description %}
{%- set canonical = page.url | absUrl(site) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
{% if site.noindex %}<meta name="robots" content="noindex, nofollow">{% elif noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:type" content="{{ 'article' if layout_type == 'post' else 'website' }}">
<meta property="og:locale" content="ko_KR">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ (image or site.ogImage) | absUrl(site) }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/style.css">
{% if page.url != "/" and not noindex %}
<script type="application/ld+json">{{ page | breadcrumbLd(title, parent, site) | jsonld | safe }}</script>
{% endif %}
{% if layout_type == "post" %}
<script type="application/ld+json">{{ page | articleLd(title, description, date, updated, site) | jsonld | safe }}</script>
{% endif %}
{% if site.adsenseId %}<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseId }}" crossorigin="anonymous"></script>{% endif %}
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav aria-label="주요 메뉴">
      <a href="/posts/">글</a>
      <a href="/calculator/">계산기</a>
      <a href="/about/">소개</a>
    </nav>
  </div>
</header>
<main class="wrap">
  {% if page.url != "/" and not noindex %}
  <nav class="crumbs" aria-label="현재 위치">
    <a href="/">홈</a>{% if parent %} › <a href="{{ parent.url }}">{{ parent.name }}</a>{% endif %} › <span>{{ title }}</span>
  </nav>
  {% endif %}
  {{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>본 사이트의 내용은 일반적인 정보 제공이 목적이며 금융상품 가입을 권유하지 않습니다. 실제 조건은 금융사·계약서에서 반드시 확인하세요.</p>
    <p><a href="/about/">운영자 소개</a> · <a href="/privacy/">개인정보처리방침</a> · <a href="/contact/">문의</a></p>
    <p>© {{ site.name }}</p>
  </div>
</footer>
</body>
</html>
