{% set pc = post.data.category | categoryInfo %}
<li class="card{% if feature %} card-feature{% endif %}">
  {% if pc %}<p class="tag">{{ pc.name }}</p>{% endif %}
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p class="desc">{{ post.data.description }}</p>
  <time datetime="{{ post.date | dateYmd }}">{{ post.date | dateYmd }}</time>
</li>
